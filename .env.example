OPENAI_API_KEY=sk-...
PORT=3000
# Chon che do tu dong hoac chieu dich thu cong tren trang dieu khien.
# Nguon sach tu mixer: none. Micro gan: near_field. Micro phong: far_field.
OPENAI_NOISE_REDUCTION=none
# Khoang lang de tach luot noi (ms); mac dinh 650.
VAD_SILENCE_MS=650
# Dia chi nguoi tham du quet QR. Dat IP LAN cua may chu, vi du:
PUBLIC_BASE_URL=http://192.168.1.50:3000
