OPENAI_API_KEY=sk-...
PORT=3000
# Chon chieu dich Anh -> Viet hoac Viet -> Anh tren trang dieu khien.
# Nguon sach tu mixer: none. Micro gan: near_field. Micro phong: far_field.
OPENAI_NOISE_REDUCTION=none
# Phu de nguon hop nhat tu khoa tu cac JSON goc va _vN; am thanh dung gpt-realtime-translate.
# Neu project chua co quyen gpt-live-transcribe, co the chon gpt-realtime-whisper.
OPENAI_SOURCE_TRANSCRIPTION=gpt-live-transcribe
# Dia chi nguoi tham du quet QR. Dat IP LAN cua may chu, vi du:
PUBLIC_BASE_URL=
