OPENAI_API_KEY=sk-...
PORT=3000
# Chon chieu dich Anh -> Viet hoac Viet -> Anh tren trang dieu khien.
# auto: mic may tinh/phong dung far_field; tin hieu sach tu mixer tat loc API.
# Co the ghi de bang none, near_field (mic gan), hoac far_field (mic phong).
OPENAI_NOISE_REDUCTION=auto
# Phu de nguon dung tu khoa tu 2 file JSON. Am thanh dich van dung gpt-realtime-translate.
# Neu project chua co quyen gpt-live-transcribe, co the chon gpt-realtime-whisper.
OPENAI_SOURCE_TRANSCRIPTION=gpt-live-transcribe
# Dia chi nguoi tham du quet QR. Dat IP LAN cua may chu, vi du:
PUBLIC_BASE_URL=http://192.168.1.50:3000
